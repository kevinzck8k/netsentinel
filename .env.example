# Application
APP_NAME=telco-multi-agent-aiops
APP_ENV=lab
LOG_LEVEL=INFO
OFFLINE_MODE=false

# Syslog UDP receiver (5514 avoids root; map real 514 via iptables/LB in prod)
SYSLOG_BIND_HOST=0.0.0.0
SYSLOG_BIND_PORT=5514

# Redis Streams
REDIS_URL=redis://localhost:6379/0
REDIS_STREAM_KEY=telco:syslog:events
REDIS_DLQ_STREAM_KEY=telco:syslog:dlq
REDIS_CONSUMER_GROUP=aiops-pipeline
# Leave unset for automatic hostname-pid identity in multi-worker deployments.
# REDIS_CONSUMER_NAME=worker-1
REDIS_PENDING_IDLE_MS=30000
REDIS_MAX_DELIVERY_ATTEMPTS=3
REDIS_STREAM_MAXLEN=500000

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=telco_sop_knowledge
QDRANT_VECTOR_SIZE=1536

# LLM / Embeddings (leave empty to auto-enable offline heuristics)
OPENAI_API_KEY=
# DeepSeek (OpenAI-compatible): set provider + key, then:
#   LLM_PROVIDER=deepseek OPENAI_API_KEY=sk-... python eval_runner.py --ablation --no-ingest
# LLM_PROVIDER=deepseek
# OPENAI_API_KEY=sk-your-deepseek-key
# OPENAI_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat
LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
LLM_TEMPERATURE=0.0

# Lab nodes (Containerlab mgmt IPs — adjust after `containerlab inspect`)
# LAB_NODES_JSON={"r1":{"host":"172.20.20.11","port":22,"username":"root","password":"","device_type":"linux","mgmt_ip":"192.168.12.1"},"r2":{"host":"172.20.20.12","port":22,"username":"root","password":"","device_type":"linux","mgmt_ip":"192.168.12.2"}}
PREFER_DOCKER_EXEC=true
# Online mode fails closed when real telemetry is unavailable. Enable only for demos.
ALLOW_SIMULATED_TELEMETRY=false
DOCKER_CONTAINER_PREFIX=clab-telco-aiops-

# Observability
OTEL_ENABLED=true
OTEL_SERVICE_NAME=telco-aiops-pipeline
OTEL_EXPORTER_ENDPOINT=http://localhost:4318
TRACELOOP_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
